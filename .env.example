# ---- Anthropic (room photo analysis via Claude vision) ----
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- parse.bot IKEA API ----
# Build an IKEA product-search API at https://parse.bot and paste the details here.
# Endpoint pattern: https://api.parse.bot/scraper/{SCRAPER_ID}/{SEARCH_ENDPOINT}
# Keys start with "pmx_". Leave PARSE_BOT_API_KEY empty to run on mock IKEA data.
PARSE_BOT_API_KEY=
PARSE_BOT_SCRAPER_ID=
# Name of the search endpoint you defined in parse.bot (e.g. "search_products")
PARSE_BOT_SEARCH_ENDPOINT=search_products
# Name of the JSON field your endpoint expects the search term in (e.g. "query")
PARSE_BOT_QUERY_PARAM=query
